<odoo>
    <record id="mgmtsystem_system_action" model="ir.actions.act_window">
        <field name="name">Systems</field>
        <field name="res_model">mgmtsystem.system</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_mgmtsystem_system"
        name="Systems"
        parent="menu_mgmtsystem_configuration"
        action="mgmtsystem_system_action"
        sequence="10"
    />

    <record id="mgmtsystem_system_view_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.system.tree</field>
        <field name="model">mgmtsystem.system</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="mgmtsystem_system_view_form" model="ir.ui.view">
        <field name="name">mgmtsystem.system.form</field>
        <field name="model">mgmtsystem.system</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>